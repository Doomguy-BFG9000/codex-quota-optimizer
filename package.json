{
  "name": "codex-quota-optimizer",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "test": "node --test tests/regressions.test.mjs && tsx --test tests/codex_skill.test.ts src/engine/quotaEngine.test.ts",
    "test:skill": "node --test tests/regressions.test.mjs",
    "sync:skill": "node scripts/sync-skill.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:preview": "node scripts/demo.mjs --write-preview"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  },
  "description": "Offline Codex quota telemetry, task scheduling, and local simulator",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "skills/",
    "install.sh",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "AGENTS.md",
    "src/",
    "server.ts",
    "tsconfig.json",
    "vite.config.ts",
    "index.html",
    "tests/",
    "scripts/",
    ".agents/skills/",
    "CONTRIBUTING.md",
    "docs/"
  ]
}
